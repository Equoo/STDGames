environ = { "STORE"= "steam", "GAMEID"= "240" }
overlays = [ "$GAMES_DIR/css" ]
start = [ "hl2.exe", "-game", "cstrike" ]


[[games]]
slug = "csgo"
status = "working"

[games.metadata]
api.id = 1372
api.client = "igdb"


# [games.launch]
# proton = "ge7.55"
# environ = { "STORE"= "steam", "GAMEID"= "240" }
# overlays = [ "$GAMES_DIR/csgo_new" ]
# start = [ "CSGOLoader.exe" ]

[games.launch]
proton = "ge9.23"
environ = { "STORE"= "steam", "GAMEID"= "240", "PROTON_USE_WINED3D"="0", "DRI_PRIME"="1", "vblank_mode"="0" }
overlays = [ "$GAMES_DIR/csgo" ]
prestart = [ "$GAMES_DIR/.resources/csgo_temp.sh" ]
# before = ["/usr/bin/gamescope", "-W", "1920", "-H", "1080", "-f", "--adaptive-sync", "--"]
start = ["CSGOLoader.exe", "-vulkan", "+fps_max", "60", "-windowed", "-noborder", "+mat_queue_mode", "2", "-nod3d9ex", "+mat_vsync", "0" ]
#
# [games.launch]
# noruntime = true
# environ = { "STORE"= "steam", "GAMEID"= "730", "DRI_PRIME"= "1"}
# overlays = [ "$GAMES_DIR/csgo_new" ]
# start = [ "steam-runtime/run.sh", "./csgo.sh", "-vulkan" ]


