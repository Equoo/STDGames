# Useful env variables:
# $GAMES_DIR - path to the games directoryy
# DRI_PRIME - set to 1 to use the discrete GPU on hybrid graphics systems
# MANGOHUD - set to 1 to enable MangoHud
# MANGOHUD_CONFIG - config string for MangoHud, see
# WINEDLLOVERRIDES - set to e.g. "winhttp.dll=n,b" to override DLL loading in Proton/Wine
#					- This exemple is usefull for unity games modding
#					- "n" means native, "b" means builtin
#					- Multiple overrides can be separated by semicolon, e.g. "winhttp.dll=n,b;d3d11.dll=n,b"
# DXVK_HUD - set to e.g. "1,fps" to enable DXVK HUD
# STORE - set to "steam" or "epic" to indicate the store used
# GAMEID - set to the game's store ID (e.g. Steam AppID)
# PROTON_USE_WINED3D - set to 1 to use WineD3D instead of DXVK in Proton
# PROTON_NO_ESYNC - set to 1 to disable esync in Proton
#
#
# Example:
# [[games]]
# slug = "mygame"
# status = "working"

# [games.metadata]
# api.id = 123456
# api.client = "steam"
# OR
# api.id = 123456
# api.client = "igdb"
# OR
# name = "My Game"
# icon = "mygame-icon.png"
# logo = "mygame-logo.png"
# hero = "mygame-hero.png"
# cover = "mygame-cover.png"
# description = "This is my game."
# short_description = "Short description of my game."
# screenshots = [ "screenshot1.png", "screenshot2.png" ]
# movies = [ "movie1.mp4", "movie2.mp4" ]
# movies_thumbnails = [ "movie1-thumb.png", "movie2-thumb.png" ]
# tags = [ "Action", "Adventure", "Indie" ]

# [games.launch]
# proton = "ge9.23" # optional, use Proton version "ge9.23"
# environ = { "STORE"= "steam", "GAMEID"= "123456", "DRI_PRIME"= "1", "MANGOHUD"= "1" } # optional, additional env variables
# overlays = [ "$GAMES_DIR/mygame" ] # optional, paths to overlay directories
# start = [ "mygame.sh", "-arg1", "value1" ] # command to start the game


[[games]]
slug = "hytale"
status = "working"

[games.metadata]
api.id = 113360
api.client = "igdb"

[games.launch]
noruntime = true
environ = { "STORE"= "igdb", "GAMEID"= "113360", "DRI_PRIME"= "1"}
overlays = [ "$GAMES_DIR/hytale" ]
prestart = ["$GAMES_DIR/hytale/install.sh"]
start = [ "AppRun" ]

[[games]]
slug = "norestforthewicked"
status = "working"

[games.metadata]
api.id = 1371980
api.client = "steam"

[games.launch]
proton = "ge10.25"
environ = { "STORE"= "steam", "GAMEID"= "1371980", "DRI_PRIME"= "1","PROTON_USE_WINED3D" = "1"}
overlays = [ "$GAMES_DIR/norestforthewicked/No-Rest-For-The-Wicked-AnkerGames/NoRestForTheWicked" ]
start = [ "NoRestForTheWicked.exe" ]

[[games]]
slug = "turzu"
status = "working"


[games.metadata]
name = "Yuzu"
icon = "https://imgs.search.brave.com/F_9Av5om9D6iEfHBKiDaEHPORXuMY8YxfPNqCFWMztI/rs:fit:860:0:0:0/g:ce/aHR0cHM6Ly9lbXV5/dXp1LmNvbS93cC1j/b250ZW50L3VwbG9h/ZHMvMjAyNC8wNS9Z/dXp1LUVtdWxhdG9y/LWljb24tMzAweDMw/MC53ZWJw"
hero = "https://upload.wikimedia.org/wikipedia/commons/a/a7/Nintendo_Switch_Logo.png"
cover = "https://upload.wikimedia.org/wikipedia/commons/a/a7/Nintendo_Switch_Logo.png"
description = "Yuzu is an open-source emulator for the Nintendo Switch from the creators of Citra. Yuzu is written in C++ with portability in mind, with builds actively maintained for Windows and Linux. Yuzu is capable of running many commercial games, and is actively being developed to increase compatibility and performance."
short_description = "Yuzu is an open-source emulator for the Nintendo Switch from the creators of Citra."
tags = [ "Emulator" ]

[games.launch]
noruntime = true
overlays = [ "$GAMES_DIR/turzu/additionnals/home" ]
start = [ "$GAMES_DIR/turzu/start.sh" ]


[[games]]
slug = "steam"
status = "working"

[games.metadata]
name = "Steam"
icon = "https://upload.wikimedia.org/wikipedia/commons/thumb/8/83/Steam_icon_logo.svg/500px-Steam_icon_logo.svg.png"
hero = "https://f5e7ceb8.delivery.rocketcdn.me/wp-content/uploads/2020/04/Logotip-Steam.jpg"
cover = "https://global-img.gamergen.com/steam-logo-icone-head-banner_0900954356.jpg"
description = "Yuzu is an open-source emulator for the Nintendo Switch from the creators of Citra. Yuzu is written in C++ with portability in mind, with builds actively maintained for Windows and Linux. Yuzu is capable of running many commercial games, and is actively being developed to increase compatibility and performance."
short_description = "Yuzu is an open-source emulator for the Nintendo Switch from the creators of Citra."
tags = [ "Store" ]

[games.launch]
noruntime = true
# environ = { "HOME"="/tmp/$USER/stdgames/work" }
overlays = [ "$GAMES_DIR/steam" ]
# start = [ "/usr/bin/env", "HOME=/tmp/$USER/stdgames/work", ".local/share/Steam/steam.sh" ]
start = [ "/usr/bin/env", "HOME=/tmp/$USER/stdgames/work", "/usr/bin/steam" , "steam://run/480" ]

