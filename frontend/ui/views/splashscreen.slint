// ← routes/splashscreen/+page.svelte: a small borderless window shown first, with a progress
// bar driven from Rust (simulating real progress events, since there's no real backend here).
export component SplashWindow inherits Window {
    no-frame: true;
    width: 420px;
    height: 260px;
    title: "STDGames";
    background: #000000;

    in property <float> progress: 0.0;

    Image {
        source: @image-url("../../assets/icons/stdgames.png");
        width: 100%;
        height: 100%;
        image-fit: cover;
    }

    Rectangle {
        y: parent.height - self.height;
        height: 12px;
        background: #444444;

        Rectangle {
            width: parent.width * root.progress;
            height: 100%;
            background: #76c7c0;
            animate width { duration: 200ms; easing: ease-in-out; }
        }
    }
}
