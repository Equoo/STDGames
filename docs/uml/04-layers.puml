@startuml Layer_implementations_one_slot_each
title Layer implementations (one slot each)
hide empty members
skinparam classAttributeIconSize 0
skinparam wrapWidth 260

package "stdg-layers-sandbox" {
  class ContyLayer {
    +conty_path : Option<PathBuf>
    +sandbox_level : Option<u8>
    +base_dir : Option<PathBuf>
    --
    {static} +new() : ContyLayer
    {static} +at(conty_path: PathBuf) : ContyLayer
  }
}

package "stdg-layers-runtime" {
  class PressureVesselLayer {
    +variant : PressureVesselVariant
    +depot_path : PathBuf
  }
  enum PressureVesselVariant <<enum>> {
    Soldier
    Sniper
  }
}

package "stdg-layers-compat" {
  class ProtonLayer {
    +version : String
    +proton_path : PathBuf
    +prefix_path : PathBuf
    +steam_client_path : Option<PathBuf>
  }
  class WineLayer {
    +version : String
    +wine_path : PathBuf
    +prefix_path : PathBuf
    +steam_client_path : Option<PathBuf>
  }
}

package "stdg-layers-steamapi" {
  class SteamApiNativeLayer {
    +app_id : String
  }
  class SteamApiEmuLayer <<stub>> {
    +variant : EmuVariant
  }
  enum EmuVariant <<enum>> {
    PlainReplace
    OverNative
  }
}

package "stdg-layers-supervision" {
  class SupervisionLayer {
    +cgroup_parent : PathBuf
  }
}

' referenced from elsewhere, shown without members for context
interface Layer <<trait>>
class CommandSpec
class LaunchCtx
class Binding
interface SessionGuard <<trait>>
class Diagnostic

' realizations (trait/interface implementations)
ContyLayer ..|> Layer
PressureVesselLayer ..|> Layer
ProtonLayer ..|> Layer
WineLayer ..|> Layer
SteamApiNativeLayer ..|> Layer
SteamApiEmuLayer ..|> Layer
SupervisionLayer ..|> Layer

' associations
PressureVesselLayer -- "1" PressureVesselVariant : variant
SteamApiEmuLayer -- "1" EmuVariant : variant

' dependencies (uses / produces)
Layer ..> LaunchCtx
Layer ..> CommandSpec
Layer ..> Outcome
Layer ..> Binding
Layer ..> SessionGuard
Layer ..> Diagnostic

@enduml
