{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "stdgames",
  "version": "0.1.5",
  "identifier": "com.stdgames.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "splashscreen",
        "url": "/splashscreen",
        "title": "std::Games",
        "minWidth": 400,
        "minHeight": 400,
        "width": 400,
        "height": 400,
        "transparent": true,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "visible": false,
        "maximizable": false,
        "minimizable": true
      },
      {
		    "maximized": true,
        "label": "main",
        "title": "std::Games",
        "visible": false,
        "minWidth": 600,
        "minHeight": 400,
        "width": 1600,
        "height": 900,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required --disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --enable-features=VaapiVideoDecoder --use-gl=egl --enable-zero-copy"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": ["deb", "rpm", "app"],
    "icon": [
      "icons/stdgames.png"
    ]
  }
}
