FROM ubuntu:22.04 AS builder

RUN apt-get update && apt-get install -y \
    sshfs \
	fuse-overlayfs \
    patchelf \
    binutils \
    --no-install-recommends && rm -rf /var/lib/apt/lists/*

WORKDIR /bundle

# Copy the binaries
RUN cp $(which sshfs) ./sshfs.bin
RUN cp $(which fuse-overlayfs) ./fuse-overlayfs.bin

RUN ldd ./sshfs.bin \
    | awk '{print $3}' \
    | grep '^/' \
    | grep -v 'libpthread\|libc\.so\|libdl\|libm\.so\|librt\|ld-linux\|libresolv\|libnss' \
    | xargs -I{} cp {} ./

RUN ldd ./fuse-overlayfs.bin \
    | awk '{print $3}' \
    | grep '^/' \
    | grep -v 'libpthread\|libc\.so\|libdl\|libm\.so\|librt\|ld-linux\|libresolv\|libnss' \
    | xargs -I{} cp {} ./

# Also grab libfuse3 and its dependencies explicitly
RUN cp /lib/x86_64-linux-gnu/libfuse3.so.3 . 2>/dev/null || true
RUN cp /usr/lib/x86_64-linux-gnu/libfuse3.so.3 . 2>/dev/null || true

# Patch the rpath so it finds libs in the same dir
RUN patchelf --set-rpath '$ORIGIN' ./sshfs.bin
RUN patchelf --set-rpath '$ORIGIN' ./fuse-overlayfs.bin

# Write the launcher wrapper
RUN cat > sshfs <<'EOF'
#!/bin/sh
SELF=$(readlink -f "$0")
DIR=$(dirname "$SELF")
export LD_LIBRARY_PATH="$DIR:$LD_LIBRARY_PATH"
exec "$DIR/sshfs.bin" "$@"
EOF
RUN chmod +x sshfs

RUN cat > fuse-overlayfs <<'EOF'
#!/bin/sh
SELF=$(readlink -f "$0")
DIR=$(dirname "$SELF")
export LD_LIBRARY_PATH="$DIR:$LD_LIBRARY_PATH"
exec "$DIR/fuse-overlayfs.bin" "$@"
EOF
RUN chmod +x fuse-overlayfs

FROM scratch
COPY --from=builder /bundle /bundle
